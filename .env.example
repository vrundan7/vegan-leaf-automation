# Copy to .env for local use ONLY. Never commit .env. Placeholders only.
# Instagram professional account ID (numeric, from the Graph API — not your @handle)
IG_USER_ID=
# Long-lived access token. Keep it out of chat, screenshots and commits.
IG_ACCESS_TOKEN=
# graph.facebook.com (Facebook Login, Page-linked account)  or  graph.instagram.com (Instagram Login)
IG_GRAPH_HOST=graph.facebook.com
IG_API_VERSION=v21.0
# Public base URL of your GitHub Pages site, e.g. https://<user>.github.io/<repo>
PAGES_BASE_URL=
# Must be exactly "true" before --publish will ever contact the publishing endpoints
PUBLISH_ENABLED=false
# Max hashtags appended to captions (Instagram began enforcing 5 per post in Dec 2025)
MAX_CAPTION_HASHTAGS=5
# Posts per Berlin calendar day (1-10). Add matching schedule slots in the workflow.
POSTS_PER_DAY=1
# Minimum hours between two posts on the same day (stops backup runs double-posting)
MIN_HOURS_BETWEEN_POSTS=2
